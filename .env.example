# Copy this file to .env and fill in real values.
# Every setting has a safe default, so the app runs in a degraded/offline
# mode even without a .env file — but the RAG Q&A feature needs a real
# ANTHROPIC_API_KEY to generate answers.

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# SEC EDGAR requires a descriptive User-Agent identifying you (they will
# rate-limit/block generic ones). Format: "Your Name your.email@example.com"
SEC_USER_AGENT=MarketPulse AI your.email@example.com

# Comma-separated tickers shown in the dashboard sidebar.
MARKETPULSE_TICKERS=AAPL,MSFT,JPM

# Optional overrides — defaults are fine for local development.
# MARKETPULSE_DB_PATH=./data/marketpulse.db
# CHROMA_PERSIST_DIR=./data/chroma

# Cost guardrails for the public "Ask a question" button (the only feature
# that calls the billed Anthropic API - everything else is free/local).
# MARKETPULSE_MAX_SESSION_QUESTIONS caps how many questions one visitor's
# browser session can ask; MARKETPULSE_MAX_DAILY_QUESTIONS caps how many
# questions ALL visitors combined can ask per calendar day (UTC), so a burst
# of traffic (or a bot) can't run up an unbounded bill. Defaults shown below.
# MARKETPULSE_MAX_SESSION_QUESTIONS=5
# MARKETPULSE_MAX_DAILY_QUESTIONS=30

# Bundled demo data loaded into an empty database on startup
# (rebuild with: python scripts/build_snapshot.py).
# MARKETPULSE_SNAPSHOT_PATH=./demo_data/snapshot.json
